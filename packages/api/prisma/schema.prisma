generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model Vendor {
  verified      Boolean                 @default(false)
  verifications VerificationApplication[]
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store?
  products  Product[]
  subOrders SubOrder[]
}

model Store {
  id          Int      @id @default(autoincrement())
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  vendorId    Int      @unique
  name        String
  city        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  level     Int
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  cart      Cart?
}

model Product {
  collectable  Boolean @default(false)
  unitOfSale   UnitOfSale @default(EACH)
  id          Int           @id @default(autoincrement())
  vendor      Vendor        @relation(fields: [vendorId], references: [id])
  vendorId    Int
  category    Category?     @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  status      ProductStatus @default(DRAFT)
  title       String
  description String?
  priceCents  Int
  currency    String        @default("USD")
  quantity    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderItems  OrderItem[]
  cartItems   CartItem[]
  images      ProductImage[]
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  EXPIRED
}

model Order {
  id         Int         @id @default(autoincrement())
  user       User        @relation(fields: [userId], references: [id])
  userId     Int
  status     OrderStatus @default(PENDING_PAYMENT)
  totalCents Int
  currency   String      @default("USD")
  expiresAt  DateTime?
  deliveryName       String?
  deliveryPhone      String?
  deliveryLine1      String?
  deliveryLine2      String?
  deliveryCity       String?
  deliveryPostalCode String?
  deliveryCountry    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  subOrders  SubOrder[]
  payments   Payment[]
  items      OrderItem[]
}

model SubOrder {
  fulfilment     Fulfilment @default(DELIVERY)
  readyAt         DateTime?
  collectionCode  String?
  collectionPreferredTime String?
  commissionCents   Int           @default(0)
  vendorShareCents Int           @default(0)
  payoutStatus     PayoutStatus @default(UNPAID)
  payoutReference  String?
  id         Int         @id @default(autoincrement())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  vendor     Vendor      @relation(fields: [vendorId], references: [id])
  vendorId   Int
  status     OrderStatus @default(PENDING_PAYMENT)
  totalCents Int
  currency   String      @default("USD")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]

  @@unique([orderId, vendorId])
}

model OrderItem {
  unitOfSale UnitOfSale @default(EACH)
  id         Int      @id @default(autoincrement())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    Int
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  subOrderId Int
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
  quantity   Int
  unitCents  Int
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  position  Int
  filePath  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@unique([productId, position])
}

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int        @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}



enum PaymentProvider {
  TEST
  PAYNOW
  ECOCASH
  STRIPE
  PAYPAL
  CRYPTO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  NEEDS_REFUND
}

enum PayoutStatus {
  UNPAID
  PAID_OUT
}

model Payment {
  id                Int             @id @default(autoincrement())
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId           Int
  provider          PaymentProvider
  providerReference String          @unique
  status            PaymentStatus   @default(PENDING)
  amountCents       Int
  currency          String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
}

enum UnitOfSale {
  EACH
  PER_HEAD
  PER_KG
  PER_CRATE
}


enum DocumentType {
  FARM_OWNERSHIP
  OFFER_LETTER
  PERMIT
  LEASE_AGREEMENT
  AFFIDAVIT
  DEALER_LICENCE
}

enum ApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model VerificationApplication {
  id                    Int               @id @default(autoincrement())
  vendor                Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId              Int
  status                ApplicationStatus @default(PENDING_REVIEW)
  idNumber              String
  idCheckStatus         String            @default("NOT_RUN")
  holderName            String
  relationshipNote      String?
  documentType          DocumentType
  documentRef           String
  affidavitCommissioned Boolean           @default(false)
  licenceNumber         String?
  farmName              String?
  province              String?
  district              String?
  saleLocation          String?
  reviewerNote          String?
  reviewedBy            Int?
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([vendorId])
}

enum Fulfilment {
  DELIVERY
  COLLECTION
}


